{
  "schemaVersion": 3,
  "pluginId": "official.workspace-calendar",
  "name": "Calendar",
  "author": {
    "name": "Batestinha",
    "url": "https://github.com/Batestinha"
  },
  "description": "Publishes a community’s event schedule to the Workspace calendar feed used by Hub and Gallery. Administrators can enable or disable publication for each scope.",
  "kind": "managed_group",
  "version": "1.1.1",
  "coreApiRange": "^0.3.34",
  "entrypoint": "dist/index.js",
  "messageNamespace": "official.workspace-calendar",
  "descriptionKey": "official.workspace-calendar.description",
  "commands": [],
  "workspaceCapabilities": [
    {
      "capabilityId": "calendar.feed.replace.v1",
      "enabledSetting": "publishCalendar"
    },
    {
      "capabilityId": "calendar.subscription.status.v1",
      "enabledSetting": "publishCalendar"
    }
  ],
  "services": [
    {
      "serviceId": "official.workspace-calendar.projection.v1",
      "methods": [
        {
          "name": "replace",
          "access": "mutation",
          "timeoutMs": 30000
        }
      ]
    },
    {
      "serviceId": "official.workspace-calendar.subscriptions.v1",
      "methods": [
        {
          "name": "read",
          "access": "read"
        }
      ]
    }
  ],
  "dependencies": [
    {
      "pluginId": "official.integration-manager",
      "versionRange": "^1.3.0"
    }
  ],
  "integrations": [
    {
      "pluginId": "official.community-events",
      "versionRange": "*",
      "description": "Receives event schedules for publication to the Workspace calendar."
    }
  ],
  "requiredPermissions": [],
  "requiredBotCapabilities": [],
  "dangerousActions": [],
  "backgroundJobs": [],
  "cancellation": {
    "workflows": []
  },
  "operatorConsole": {
    "controls": [
      {
        "path": "publishCalendar",
        "id": "plugin.official.workspace-calendar.publishCalendar",
        "label": "Publish calendar",
        "description": "Publish event changes from Community Events.",
        "section": "Calendar",
        "order": 10,
        "schema": {
          "type": "boolean"
        },
        "ui": {
          "widget": "toggle",
          "helpText": "Publish event changes from Community Events."
        },
        "dangerous": false,
        "sensitivity": {
          "sensitive": false,
          "redact": "none"
        },
        "relatedCommandIds": [],
        "relatedActionIds": []
      }
    ],
    "pages": [],
    "internalConfigPaths": [],
    "configPaths": [
      "publishCalendar"
    ]
  },
  "help": {
    "featureId": "workspace-calendar",
    "titleKey": "official.workspace-calendar.title",
    "summaryKey": "official.workspace-calendar.description",
    "topics": [
      {
        "topicId": "workspace-calendar",
        "titleKey": "official.workspace-calendar.title",
        "summaryKey": "official.workspace-calendar.description",
        "commands": [],
        "instructionKeys": [
          "official.workspace-calendar.description"
        ]
      }
    ]
  },
  "memberSubscriptions": [
    {
      "id": "calendar",
      "kind": "external",
      "scope": "community",
      "serviceId": "official.workspace-calendar.subscriptions.v1",
      "labelKey": "official.workspace-calendar.subscription.title"
    }
  ],
  "operationCatalogVersion": 1
}
